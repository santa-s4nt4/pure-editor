{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "pure のローカルノートと R2 同期。外部 iframe には権限を付与しません。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "clipboard-manager:allow-read-image",
    "core:image:allow-size",
    "core:image:allow-rgba",
    "core:resources:allow-close",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-stat",
    "fs:allow-rename",
    "fs:allow-remove",
    { "identifier": "fs:scope", "allow": ["$APPDATA", "$APPDATA/**", "$APPCONFIG", "$APPCONFIG/**"] },
    { "identifier": "http:default", "allow": [{ "url": "https://*.r2.cloudflarestorage.com/**" }] },
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }] }
  ]
}
