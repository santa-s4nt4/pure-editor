{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "article",
  "description": "記事の閲覧用ウィンドウ。保存・同期はメインウィンドウが担当します。",
  "windows": [
    "article-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPDATA",
        "$APPDATA/**",
        "$APPCONFIG",
        "$APPCONFIG/**"
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    }
  ]
}
